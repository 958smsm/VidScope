{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC + local Qt/FFmpeg",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "D:/dev/Qt/Tools/Ninja/ninja.exe",
        "CMAKE_PREFIX_PATH": "D:/dev/Qt/6.11.2/msvc2022_64",
        "FFMPEG_ROOT": "D:/dev/ffmpeg-master-latest-win64-gpl-shared",
        "BUILD_TESTING": "ON",
        "VIDSCOPE_BUILD_TESTS": "ON",
        "VIDSCOPE_DEPLOY_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}


